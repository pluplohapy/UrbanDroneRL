evaluate:
# main model + cylinders - nothing
python training/evaluate.py --model models/ppo_pretrain_dynamic_mix.zip --normalize models/vec_normalize_pretrain_dynamic_mix.pkl --stage pretrain --obstacle-type cylinders --episodes 50 --seed 12345 --no-safety-shield --json-out reports/eval_main_after_fix.json
# main model + dynamic_mix - nothing
python training/evaluate.py --model models/ppo_pretrain_dynamic_mix.zip --normalize models/vec_normalize_pretrain_dynamic_mix.pkl --stage pretrain --obstacle-type dynamic_mix  --episodes 50 --seed 12345 --no-safety-shield --json-out reports/eval_main_after_fix.json;

# main model + LSTM
python training/evaluate.py --algo recurrent_ppo --model models/recurrent_ppo_pretrain_dynamic_mix.zip --normalize models/vec_normalize_recurrent_ppo_pretrain_dynamic_mix.pkl --stage pretrain --obstacle-type dynamic_mix --episodes 50 --seed 12345 --no-safety-shield --json-out reports/eval_recurrent_ppo_dynamic_mix.json
# best model + LSTM
python training/evaluate.py --algo recurrent_ppo --model models/best_checkpoints/RecurrentPPO_pretrain_dynamic_mix/best_model.zip --normalize models/best_checkpoints/RecurrentPPO_pretrain_dynamic_mix/best_model_vecnormalize.pkl --stage pretrain --obstacle-type dynamic_mix --episodes 50 --seed 12345 --no-safety-shield



